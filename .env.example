# Скопируйте этот файл в .env и заполните собственными значениями.
# Реальные секреты сюда не добавляются и не коммитятся.

# Сгенерируйте свой ключ, например:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changeme-generate-your-own-secret-key
